# Build output
# NOTE: anchored with a leading slash on purpose. An unanchored
# "llm-eyes-mcp" would also match the cmd/llm-eyes-mcp/ source directory.
/bin/
/llm-eyes-mcp
/llm-eyes-mcp.exe
/llm-eyes-mcp-*

# User config & secrets (keep the .example templates tracked)
/config.yml
/.env

# Cache database files (if ever created inside the repo)
*.db
*.db-shm
*.db-wal

# OS / editor noise
.DS_Store
*.swp
*~

# WorkBuddy memory — extracted to docs/archive/memory-archive.md
/.workbuddy/

# Test artefacts
*.out
coverage.txt

# Local capture / media artefacts — dev harnesses in scripts/ reference
# screenshots/ by local path only
/screenshots/
/generated-images/
/generated-videos/

node_modules/
