# Environment variables for llm-eyes-mcp.
#
# Copy to .env and fill in, or export them in your shell. These mirror the
# ${VAR} references used in config.yml.example. The server reads them when it
# expands the config document (it does NOT read .env itself - your launcher
# or shell is responsible for exporting them).

# Absolute path to the config file. Highest priority, above --config and cwd.
LLM_EYES_CONFIG=/absolute/path/to/config.yml

# Provider credentials. Any name works as long as config.yml references it.
GLM_API_KEY=your-glm-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: point at a local OpenAI-compatible vision endpoint.
LOCAL_VLM_BASE_URL=http://127.0.0.1:8214/v1
