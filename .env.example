# Environment variables for llm-eyes-mcp.
#
# Copy to .env and fill in, or export them in your shell. These cover the
# ${VAR} references your config.yml typically uses. The server reads them when
# it expands the config document (it does NOT read .env itself - your launcher
# or shell is responsible for exporting them; the cmd/ harnesses do parse
# .env as a fallback).

# Absolute path to the config file. Highest priority, above --config and cwd.
LLM_EYES_CONFIG=/absolute/path/to/config.yml

# Provider credentials. Any name works as long as config.yml references it.
GLM_API_KEY=your-glm-key-here
OPENAI_API_KEY=sk-your-openai-key-here
# Gateway key for the uoma vision provider (referenced by config.yml's
# UOMA_API_KEY entries, e.g. the vision_glm provider that `make e2e` drives).
UOMA_API_KEY=sk-your-uoma-gateway-key-here

# Upstream key for cmd/llm-eyes-probe, whose --key-env defaults to this name.
NVIDIA_API_KEY=sk-your-nvidia-nim-key-here

# Optional: point at a local OpenAI-compatible vision endpoint.
LOCAL_VLM_BASE_URL=http://127.0.0.1:8214/v1
